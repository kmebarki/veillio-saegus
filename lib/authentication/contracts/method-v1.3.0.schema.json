{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:veillio:authentication:method:1.3",
  "title": "Veillio authentication method definition v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "methodId",
    "displayName",
    "familyId",
    "variantId",
    "supportedVariantIds",
    "version",
    "schemaRevision",
    "lifecycle",
    "runtime",
    "fieldSchema",
    "transmission",
    "composition",
    "compatibility"
  ],
  "properties": {
    "methodId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "familyId": {
      "type": "string"
    },
    "variantId": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "legacyVersionLabel": {
      "type": "string"
    },
    "schemaRevision": {
      "type": "integer",
      "minimum": 1
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "approvedBy",
        "approvedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "brouillon",
            "a_valider",
            "disponible",
            "desactivee",
            "obsolete"
          ]
        },
        "reason": {
          "type": "string"
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "handlerKey",
        "handlerVersion",
        "deployed",
        "securityReviewed",
        "contractTestsPassed",
        "enabled"
      ],
      "properties": {
        "handlerKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "handlerVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "deployed": {
          "type": "boolean"
        },
        "securityReviewed": {
          "type": "boolean"
        },
        "contractTestsPassed": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fieldSchema": {
      "type": "object",
      "required": [
        "schemaVersion",
        "fields"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.3.0"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "additionalProperties": false
    },
    "transmission": {
      "type": "object",
      "required": [
        "type",
        "protocol",
        "bindings",
        "handlerOperation",
        "requiresTls",
        "resolvedBy",
        "customHeadersAllowed",
        "policyRef"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "handlerOperation": {
          "type": "string"
        },
        "requiresTls": {
          "type": "boolean"
        },
        "resolvedBy": {
          "const": "verifiedAdapterAndHandler"
        },
        "customHeadersAllowed": {
          "const": false
        },
        "policyRef": {
          "const": "HTTP_TRANSMISSION_POLICY_V1_3"
        },
        "placementOptions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "note": {
          "type": "string"
        },
        "oauthProfileRef": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "required": [
        "identityModel",
        "secondaryFactorsAllowed",
        "requiresAdapterDeclaration"
      ],
      "properties": {
        "identityModel": {
          "type": "boolean"
        },
        "secondaryFactorsAllowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiresAdapterDeclaration": {
          "type": "boolean"
        },
        "delegatesTo": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "sourceOfTruth",
        "serviceIds",
        "adapterIds"
      ],
      "properties": {
        "sourceOfTruth": {
          "const": "connectors.adapterRegistry"
        },
        "serviceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adapterIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "supportedVariantIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "type",
        "required",
        "secret",
        "description",
        "order",
        "validation",
        "visibility",
        "defaultValue",
        "valueSource",
        "editableInConnection"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "password",
            "url",
            "dateTime",
            "list",
            "enum",
            "file",
            "secretFile",
            "certificate"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "defaultValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string"
            },
            "minLength": {
              "type": "integer",
              "minimum": 0
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0
            },
            "pattern": {
              "type": "string"
            },
            "enum": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "visibility": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "operator": {
                  "const": "always"
                }
              },
              "required": [
                "operator"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "operator",
                "fieldCode",
                "value"
              ],
              "properties": {
                "operator": {
                  "const": "equals"
                },
                "fieldCode": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "storage": {
          "type": "object",
          "required": [
            "scope",
            "mode",
            "readBack"
          ],
          "properties": {
            "scope": {
              "const": "connection"
            },
            "mode": {
              "const": "vaultRef"
            },
            "readBack": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "valueSource": {
          "enum": [
            "connection.secretRef",
            "connection.config",
            "adapter.nonSecretConfig"
          ]
        },
        "editableInConnection": {
          "type": "boolean"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "target",
        "source",
        "format",
        "required",
        "clientEditable"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "target": {
          "type": "object"
        },
        "source": {
          "type": "object"
        },
        "format": {
          "type": "object"
        },
        "required": {
          "type": "boolean"
        },
        "clientEditable": {
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
